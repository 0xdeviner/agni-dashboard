{
  "name": "agni-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Agni Recon Dashboard - Backend",
  "main": "app.js",
  "scripts": {
    "dev:server": "nodemon app.js",
    "dev:client": "npm --prefix client run dev -- --host --port 5173",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:client",
    "start": "node app.js",
    "create:user": "node create_user.js",
    "create:indexes": "node scripts/create-indexes.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^5.9.2",
    "morgan": "^1.10.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.0"
  }
}
